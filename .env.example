# Copy to .env.local and fill in. Never commit .env.local.
# Vars marked [now] are needed for the current phase; the rest are needed later.

# --- Supabase [now] ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Also set for Edge Functions with `supabase secrets set`.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FREE_MONTHLY_GENERATIONS=2
MAX_UPLOAD_MB=10
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# --- OpenAI (Phase 5) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- LaTeX compiler (Phase 6) ---
LATEX_COMPILER_URL=https://latex.ytotech.com/builds/sync

# --- Razorpay (Phase 7) ---
# Key ID is public: Razorpay Checkout in the browser uses it (rzp_test_... / rzp_live_...).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only:
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs (plan_XXXX) from Razorpay Dashboard > Subscriptions > Plans.
# Suggested: monthly ₹199, yearly ₹1,499.
RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=

# --- Supabase DB (CLI migrations only) ---
SUPABASE_DB_URL=
